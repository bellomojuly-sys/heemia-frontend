# Backend Heemia (Fase 12). Copia in server/.env e compila. Valori reali mai nel repo/vault.
NODE_ENV=development
PORT=3001
APP_BASE_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:5173
# Postgres locale (docker compose up -d nella cartella 04_Claude_Code)
DATABASE_URL=postgresql://heemia:heemia@localhost:5432/heemia_dev
# openssl rand -hex 32
SESSION_SECRET=
SESSION_TTL_HOURS=360
# usato solo dal seed per creare il primo admin
SEED_ADMIN_EMAIL=admin@heemia.local
SEED_ADMIN_PASSWORD=

# --- Chiavi API dei servizi esterni (da compilare per attivare le funzioni AI) ---
# Claude API: serve alla scansione AI del PDF della scheda tecnica (FR-14), che legge
# il documento e ne ricava i costi del capo (versioni Finale e Piazzamento e taglio).
# Si genera su https://console.anthropic.com -> API Keys.
# SENZA questa chiave il server parte lo stesso e tutto il resto funziona: solo il
# pulsante "Ricava i costi con AI" risponde dicendo che la chiave manca.
# Costo indicativo: modello claude-opus-5 ($5 per milione di token in ingresso,
# $25 in uscita) -> una scheda tecnica in PDF costa pochi centesimi.
ANTHROPIC_API_KEY=

# --- Google Analytics 4 (pagina Analytics e riquadro in dashboard) ---
# GA_PROPERTY_ID: identificativo NUMERICO della proprieta' GA4 (Amministrazione ->
# Dettagli proprieta'), senza il prefisso "properties/".
# GA_CREDENTIALS_JSON: il file JSON del service account (Google Cloud -> IAM ->
# Account di servizio -> Chiavi), incollato su UNA riga sola. Il service account va poi
# aggiunto alla proprieta' GA4 con ruolo Visualizzatore, altrimenti Google risponde
# "permission denied". In alternativa si puo' usare GOOGLE_APPLICATION_CREDENTIALS con
# il percorso del file (fuori dal repository).
# SENZA queste variabili il server parte lo stesso: solo /analytics/* risponde che
# l'integrazione non e' collegata, e il riquadro in dashboard non compare.
GA_PROPERTY_ID=
GA_CREDENTIALS_JSON=
