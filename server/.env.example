# Backend Heemia (Fase 12). Copia in server/.env e compila. Valori reali mai nel repo/vault.
NODE_ENV=development
PORT=3001
APP_BASE_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:5173
# Indirizzo pubblico del FRONTEND: entra nel link di «password dimenticata» che arriva per
# email (FR-54). Facoltativo — se manca si usa la prima origine di CORS_ORIGIN, che in
# produzione e' gia' l'indirizzo dell'app. Da compilare solo se le due cose divergono.
# APP_URL=https://heemia-app.onrender.com
# Postgres locale (docker compose up -d nella cartella 04_Claude_Code)
DATABASE_URL=postgresql://heemia:heemia@localhost:5432/heemia_dev
# openssl rand -hex 32
SESSION_SECRET=
SESSION_TTL_HOURS=360
# Facoltativa. Cifra le credenziali che si inseriscono dall'app (oggi: la chiave OpenAI).
# Se e' vuota vale SESSION_SECRET, e va benissimo cosi': serve solo a poter cambiare il
# segreto delle sessioni (che fa rientrare tutti) senza rendere illeggibile la chiave
# OpenAI gia' salvata. Stessa generazione, minimo 32 caratteri.
# ATTENZIONE: cambiarla rende illeggibili le credenziali gia' salvate. Non e' un danno
# (si reinseriscono da Impostazioni in dieci secondi) ma va saputo prima.
CREDENTIALS_SECRET=
# usato solo dal seed per creare il primo admin
SEED_ADMIN_EMAIL=admin@heemia.local
SEED_ADMIN_PASSWORD=
# Via di recupero se la password dell'amministratore si perde: mettere "true", rilanciare
# il deploy, poi RIMUOVERLA. Finche' resta, ogni deploy sovrascrive la password scelta
# dalla persona con il valore di SEED_ADMIN_PASSWORD (DEC-058).
SEED_ADMIN_FORCE_PASSWORD=

# --- Chiavi API dei servizi esterni (da compilare per attivare le funzioni AI) ---
# OpenAI (fornitore scelto in DEC-050: l'azienda usa gia' ChatGPT): serve alla scansione
# AI del PDF della scheda tecnica (FR-14), alla lettura dei DDT di rientro e all'assistente.
#
# DAL 2026-09-09 QUESTA VARIABILE NON E' PIU' LA VIA PRINCIPALE.
# La chiave la inserisce la CEO (o un amministratore) dall'app: Impostazioni -> "Account
# OpenAI dell'azienda" -> incolla -> Verifica e collega. Resta cifrata a database
# (tabella credenziali_integrazioni) e non torna mai indietro al browser. Il motivo e' di
# proprieta', non di comodita': l'abbonamento e il credito sono dell'azienda, quindi deve
# essere l'azienda a collegare l'account, senza passare da chi fa i deploy.
# Il team NON deve avere account OpenAI: usa le funzioni AI con i permessi Heemia.
#
# Questa variabile resta valida come RIPIEGO: vale quando in app non c'e' nessuna chiave
# (comodo in locale, ed e' la via di rientro se la chiave inserita si rivela sbagliata).
# Si genera su https://platform.openai.com -> API keys; meglio ancora come chiave di un
# service account del progetto, cosi' non dipende da una persona.
# ATTENZIONE: l'abbonamento ChatGPT NON comprende l'API, che ha credito e fatturazione
# separati.
# SENZA chiave (ne' in app ne' qui) il server parte lo stesso e tutto il resto funziona:
# solo le funzioni AI rispondono che l'account non e' collegato.
# Costo indicativo: modello gpt-5.6-terra ($2 per milione di token in ingresso,
# $12 in uscita) -> una scheda tecnica in PDF costa pochi centesimi.
OPENAI_API_KEY=
# Modello usato per le funzioni AI. Se vuoto vale gpt-5.6-terra (equilibrio qualita'/costo).
# Alternative: gpt-5.6-sol (piu' capace, $5/$30), gpt-5.6-luna (piu' economico, $0,20/$1,20).
OPENAI_MODEL=

# --- Gmail: invio delle richieste ai fornitori dall'app (FR-06, DEC-028) ---
# Servono tutte e quattro. Procedura passo passo in
# 03_Technical_Specification/Integrazioni_Setup.md §2 (progetto Google Cloud, schermata
# di consenso, ID client OAuth "Applicazione desktop", autorizzazione una tantum
# dell'account aziendale con il solo scope https://www.googleapis.com/auth/gmail.send).
# GMAIL_MITTENTE deve essere lo STESSO indirizzo che ha dato l'autorizzazione.
# SENZA queste variabili il server parte lo stesso: solo il pulsante "Invia al fornitore"
# risponde spiegando cosa manca, e la richiesta NON viene marcata come inviata.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GMAIL_MITTENTE=

# --- Shopify: sincronizzazione prodotti e giacenze (FR-17, DEC-009/DEC-027) ---
# Si creano nell'admin del negozio: Impostazioni -> App e canali di vendita ->
# Sviluppa app -> crea app -> permessi Admin API -> installa -> token di accesso
# (mostrato UNA sola volta). Permessi minimi e procedura in Integrazioni_Setup.md §3.
# Le app nuove del Dev Dashboard usano Client ID + Client Secret: il server ottiene un
# token valido 24 ore e lo rinnova automaticamente. SHOPIFY_ADMIN_API_TOKEN serve solo
# come compatibilità per una vecchia custom app con token statico.
# SHOPIFY_STORE_DOMAIN si scrive senza https:// (es. heemia.myshopify.com).
# SHOPIFY_API_VERSION si puo' lasciare vuota: il codice usa 2026-04.
# SHOPIFY_WEBHOOK_SECRET arriva quando si registrano i webhook: serve a verificare che
# una notifica in arrivo venga davvero da Shopify.
SHOPIFY_STORE_DOMAIN=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_ADMIN_API_TOKEN=
SHOPIFY_API_VERSION=
# Facoltativo: normalmente Shopify firma i webhook con SHOPIFY_CLIENT_SECRET. Compilare
# questo override solo durante una rotazione del secret o per una configurazione legacy.
SHOPIFY_WEBHOOK_SECRET=

# --- Fatture dei fornitori: nessuna credenziale, e non ne servono ---
# Il provider accreditato SDI NON si fa (decisione del 2026-08-13, DEC-061): le fatture
# arrivano ai commercialisti. Le variabili SDI_* sono state tolte da qui, da config.ts e
# da render.yaml: una variabile che non serve piu' e' una domanda a cui qualcuno prima o
# poi risponde per sbaglio.
# Resta l'import manuale dello ZIP dalla pagina Fatture, che e' il flusso definitivo ed e'
# quello che alimenta le uscite del report economico mensile (DEC-062).

# --- Google Drive: foto dei capi (FR-16) ---
# Serve SOLO per "importa tutte le foto da una cartella": collegare una foto alla volta con
# il link del singolo file funziona gia' senza credenziali.
# In produzione GOOGLE_DRIVE_CREDENTIALS_JSON accetta il JSON OAuth `authorized_user`
# creato dalla procedura Drive oppure il JSON di un service account, sempre su UNA riga.
# Va salvato come secret del backend (per esempio nelle Environment di Render), mai nel repo.
GOOGLE_DRIVE_CREDENTIALS_JSON=
# Alternativa: service account Google Cloud. Poi su Drive va condivisa la cartella delle
# foto con l'indirizzo email del service account, ruolo Visualizzatore.
# Se hai gia' compilato GA_CREDENTIALS_JSON per Analytics, quello vale anche qui.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Solo in locale, un OAuth Drive in sola lettura puo' usare un file dedicato. In questo
# modo Analytics non risulta configurato finche' non riceve credenziali proprie.
GOOGLE_DRIVE_CREDENTIALS_FILE=

# --- Google Analytics 4 (pagina Analytics e riquadro in dashboard) ---
# GA_PROPERTY_ID: identificativo NUMERICO della proprieta' GA4 (Amministrazione ->
# Dettagli proprieta'), senza il prefisso "properties/".
# GA_CREDENTIALS_JSON: in produzione accetta il JSON OAuth `authorized_user` oppure il
# JSON di un service account, incollato su UNA riga sola e salvato come secret. L'account
# deve poter visualizzare la proprieta' GA4. In locale si puo' usare in alternativa
# GOOGLE_APPLICATION_CREDENTIALS con il percorso del file (fuori dal repository).
# SENZA queste variabili il server parte lo stesso: solo /analytics/* risponde che
# l'integrazione non e' collegata, e il riquadro in dashboard non compare.
GA_PROPERTY_ID=
GA_CREDENTIALS_JSON=
