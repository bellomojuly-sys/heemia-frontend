{
  "name": "heemia-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Backend API Heemia App (Fase 12) — Fastify + Prisma + PostgreSQL",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "NODE_ENV=test node --env-file=.env --import tsx --test --test-concurrency=1 test/*.test.ts",
    "test:performance": "NODE_ENV=test node --env-file=.env --import tsx scripts/benchmark-health.mts",
    "census:validate": "node --import tsx scripts/validate-census.mts",
    "census:import": "node --env-file=.env --import tsx scripts/import-censimento.mts",
    "census:verifica": "node --env-file=.env --import tsx scripts/verifica-censimento.mts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.0.1",
    "@fastify/helmet": "^13.1.0",
    "@fastify/rate-limit": "^10.2.2",
    "@google-analytics/data": "^7.0.0",
    "@prisma/client": "^6.3.1",
    "bcryptjs": "^3.0.2",
    "dotenv": "^17.4.2",
    "fast-xml-parser": "^5.10.1",
    "fastify": "^5.2.1",
    "jszip": "^3.10.1",
    "openai": "^7.4.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "prisma": "^6.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
