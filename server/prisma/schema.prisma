  supplierId          String           @map("supplier_id") @db.Uuid
  supplier            Supplier         @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  materialId          String?          @map("material_id") @db.Uuid
  material            Material?        @relation(fields: [materialId], references: [id], onDelete: SetNull)
  accessoryId         String?          @map("accessory_id") @db.Uuid
  accessory           Accessory?       @relation(fields: [accessoryId], references: [id], onDelete: SetNull)
  productId           String?          @map("product_id") @db.Uuid
  product             Product?         @relation(fields: [productId], references: [id], onDelete: SetNull)
  oggetto             String
  testo               String
  quantitaRichiesta   Decimal          @default(0) @map("quantita_richiesta") @db.Decimal(10, 2)
  quantitaDisponibile Decimal          @default(0) @map("quantita_disponibile") @db.Decimal(10, 2)
  quantitaMancante    Decimal          @default(0) @map("quantita_mancante") @db.Decimal(10, 2)
  urgenza             Urgenza          @default(media)
  deadlineIdeale      DateTime?        @map("deadline_ideale") @db.Date
  stato               SupplierReqStato @default(bozza_generata)
  noteTecniche        String?          @map("note_tecniche")
  rispostaFornitore   String?          @map("risposta_fornitore")
  approvataDa         String?          @map("approvata_da") @db.Uuid
  approver            User?            @relation("ApprovedBy", fields: [approvataDa], references: [id], onDelete: SetNull)
  inviataIl           DateTime?        @map("inviata_il") @db.Timestamptz(6)
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([supplierId])
  @@map("supplier_requests")
}

model Order {
  id         String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  numero     String        @unique
  customerId String?       @map("customer_id") @db.Uuid
  customer   Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  canale     OrderCanale
  stato      OrderStato    @default(in_lavorazione)
  priorita   OrderPriorita @default(normale)
  data       DateTime      @db.Date
  totale     Decimal       @default(0) @db.Decimal(12, 2)
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  items            OrderItem[]
  /// Presente solo sugli ordini nati da una richiesta showroom confermata (DEC-044).
  showroomRequest  ShowroomRequest?
  bolleLavorazione BollaLavorazione[]

  @@index([customerId])
  @@map("orders")
}

model OrderItem {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId           String          @map("order_id") @db.Uuid
  order             Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId         String?         @map("product_id") @db.Uuid
  product           Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId         String?         @map("variant_id") @db.Uuid
  variant           ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  quantita          Int             @default(1)
  prezzoUnitario    Decimal         @default(0) @map("prezzo_unitario") @db.Decimal(12, 2)
  suMisura          Boolean         @default(false) @map("su_misura")
  materialeSceltoId String?         @map("materiale_scelto_id") @db.Uuid
  materialeScelto   Material?       @relation(fields: [materialeSceltoId], references: [id], onDelete: SetNull)
  tagliaScelta      String?         @map("taglia_scelta")
  misure            Json?
  noteSuMisura      String?         @map("note_su_misura")

  @@index([orderId])
  @@map("order_items")
}

model InventoryRecord {
  id                      String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  variantId               String         @unique @map("variant_id") @db.Uuid
  variant                 ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  qtaMagazzino            Int            @default(0) @map("qta_magazzino")
  qtaLaboratorio          Int            @default(0) @map("qta_laboratorio")
  /// Capi (semilavorati o finiti) usciti con una bolla di lavorazione esterna e ancora
  /// presso il lavorante (2026-08-10). Come i capi in produzione (DEC-047) sono una
  /// giacenza a sé: contano nel totale registrato della variante — sono roba nostra —
  /// ma **non** nel disponibile, perché non sono in casa e non si possono vendere.
  qtaPressoTerzisti       Int            @default(0) @map("qta_presso_terzisti")
  /// Semilavorati recuperati da una lavorazione: restano separati dai pezzi integri, ma
  /// possono essere selezionati esplicitamente in una nuova bolla.
  qtaScampoli             Int            @default(0) @map("qta_scampoli")
  qtaRiservata            Int            @default(0) @map("qta_riservata")
  qtaVenduta              Int            @default(0) @map("qta_venduta")
  sogliaMinima            Int            @default(0) @map("soglia_minima")
  // Soglia della sola giacenza di laboratorio: sotto questa quantità scatta l'alert di
  // reintegro dal magazzino. È distinta da `sogliaMinima`, che riguarda il totale.
  sogliaMinimaLaboratorio Int            @default(0) @map("soglia_minima_laboratorio")
  stato                   InventoryStato @default(disponibile)
  stockShopify            Int            @default(0) @map("stock_shopify")
  divergenzaShopify       Boolean        @default(false) @map("divergenza_shopify")
  updatedAt               DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  // --- Migrazione iniziale delle giacenze (DEC-045) ---
  // All'import il sistema conosce solo il totale: entra tutto in laboratorio e la
  // distribuzione reale la corregge una persona, capo per capo.
  //
  // `totaleMigrazione` è il totale dichiarato per questa variante: serve a distinguere
  // "questi 3 capi erano già nel totale, spostali" da "questi 3 capi non li avevamo
  // contati, aggiungili", e a validare la distribuzione prima della conferma.
  // Finché `migrazioneCompletata` è false la variante è in migrazione: niente alert
  // operativi (i numeri sono provvisori) e ogni modifica di ubicazione passa dalla
  // domanda esplicita. Dopo la conferma vale la gestione ordinaria.
  totaleMigrazione       Int?      @map("totale_migrazione")
  migrazioneCompletata   Boolean   @default(false) @map("migrazione_completata")
  migrazioneConfermataIl DateTime? @map("migrazione_confermata_il") @db.Timestamptz(6)
  migrazioneConfermataDa String?   @map("migrazione_confermata_da") @db.Uuid

  @@map("inventory_records")
}

// Capi in produzione: **giacenza a sé**, distinta da magazzino e laboratorio (DEC-047).
// Avviare una lavorazione toglie i capi dal laboratorio; la giacenza di laboratorio conta
// solo capi finiti, e i capi in lavorazione ci rientrano quando sono terminati.
//
// Ciclo di vita: in_produzione → terminato (il capo è finito: rientra in laboratorio)
//                             → annullato (la lavorazione decade: i capi rientrano com'erano)
//
// Il totale registrato di una variante è magazzino + laboratorio + in produzione; il
// **disponibile** resta magazzino + laboratorio, perché un capo non finito non si vende.
model StockCommitment {
  id        String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  variantId String          @map("variant_id") @db.Uuid
  variant   ProductVariant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  // Lavorazione per cui il capo è impegnato: il prodotto in produzione e, quando c'è,
  // la fase specifica della pipeline.
  productId String?         @map("product_id") @db.Uuid
  product   Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  stepId    String?         @map("step_id") @db.Uuid
  step      ProductionStep? @relation(fields: [stepId], references: [id], onDelete: SetNull)
  quantita  Int
  stato     CommitmentStato @default(in_produzione)
  note      String?
  createdBy String?         @map("created_by") @db.Uuid
  creatoDa  User?           @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  chiusoIl  DateTime?       @map("chiuso_il") @db.Timestamptz(6)

  @@index([variantId])
  @@index([stato])
  @@map("stock_commitments")
}

// =====================================================================
// MAGAZZINO MULTI-UBICAZIONE (Database_Schema.md §2, richiesta di Giulia
// 2026-08-05). `inventory_records` resta la fonte usata oggi dal backend
// (una riga per variante, colonne fisse magazzino/laboratorio); queste
// tabelle sono il modello a ubicazioni arbitrarie (magazzino, laboratorio,
// showroom, resi, produzione esterna) verso cui migrare in un passo
// successivo — vedi nota in Database_Schema.md §2.
// =====================================================================

model InventoryLocation {
  id        String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  codice    String                @unique
  nome      String
  tipo      InventoryLocationType
  indirizzo String?
  attiva    Boolean               @default(true)
  createdAt DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  balances      InventoryBalance[]
  movementiDa   InventoryMovement[]     @relation("MovimentoOrigine")
  movementiA    InventoryMovement[]     @relation("MovimentoDestinazione")
  snapshotItems InventorySnapshotItem[]

  @@map("inventory_locations")
}

model InventoryBalance {
  id                    String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  variantId             String            @map("variant_id") @db.Uuid
  variant               ProductVariant    @relation(fields: [variantId], references: [id], onDelete: Cascade)
  locationId            String            @map("location_id") @db.Uuid
  location              InventoryLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  quantitaDisponibile   Int               @default(0) @map("quantita_disponibile")
  quantitaRiservata     Int               @default(0) @map("quantita_riservata")
  quantitaInLavorazione Int               @default(0) @map("quantita_in_lavorazione")
  updatedAt             DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([variantId, locationId])
  @@index([locationId])
  @@map("inventory_balances")
}

model InventoryMovement {
  id              String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  variantId       String                @map("variant_id") @db.Uuid
  variant         ProductVariant        @relation(fields: [variantId], references: [id], onDelete: Cascade)
  locationFromId  String?               @map("location_from_id") @db.Uuid
  locationFrom    InventoryLocation?    @relation("MovimentoOrigine", fields: [locationFromId], references: [id], onDelete: SetNull)
  locationToId    String?               @map("location_to_id") @db.Uuid
  locationTo      InventoryLocation?    @relation("MovimentoDestinazione", fields: [locationToId], references: [id], onDelete: SetNull)
  createdBy       String?               @map("created_by") @db.Uuid
  creatoDa        User?                 @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  tipo            InventoryMovementType
  quantita        Int
  riferimentoTipo String?               @map("riferimento_tipo")
  riferimentoId   String?               @map("riferimento_id") @db.Uuid
  // Perché il movimento è avvenuto (reintegro, rientro, correzione, migrazione…):
  // il `tipo` dice *cosa* è successo, il motivo dice *perché*. Testo controllato dal
  // client (MOTIVI_MOVIMENTO), non enum: i motivi cambiano con l'uso e non vale una
  // migrazione ogni volta.
  motivo          String?
  note            String?
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([variantId])
  @@map("inventory_movements")
}

model InventorySnapshot {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  importBatchId String?      @map("import_batch_id") @db.Uuid
  importBatch   ImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  dataSnapshot  DateTime     @map("data_snapshot") @db.Date
  fonte         String?
  chiuso        Boolean      @default(false)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  items InventorySnapshotItem[]

  @@map("inventory_snapshots")
}

model InventorySnapshotItem {
  id         String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  snapshotId String            @map("snapshot_id") @db.Uuid
  snapshot   InventorySnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  variantId  String            @map("variant_id") @db.Uuid
  variant    ProductVariant    @relation(fields: [variantId], references: [id], onDelete: Cascade)
  locationId String            @map("location_id") @db.Uuid
  location   InventoryLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  quantita   Int
  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([snapshotId, variantId, locationId])
  @@map("inventory_snapshot_items")
}

// =====================================================================
// LISTINI FORNITORE con validità temporale (Database_Schema.md §2,
// richiesta di Giulia 2026-08-05). Oggi il prezzo vive direttamente su
// `materials.prezzo_al_metro`/`accessories.costo_unitario` con un unico
// fornitore collegato; queste tabelle permettono più fornitori/prezzi per
// materiale o accessorio, ciascuno valido in una finestra temporale.
// =====================================================================

model SupplierMaterial {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  supplierId      String        @map("supplier_id") @db.Uuid
  supplier        Supplier      @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  materialId      String        @map("material_id") @db.Uuid
  material        Material      @relation(fields: [materialId], references: [id], onDelete: Cascade)
  codiceFornitore String?       @map("codice_fornitore")
  prezzoUnitario  Decimal       @map("prezzo_unitario") @db.Decimal(10, 2)
  unitaMisura     MaterialUnita @map("unita_misura")
  quantitaMinima  Decimal?      @map("quantita_minima") @db.Decimal(10, 2)
  leadTimeGiorni  Int?          @map("lead_time_giorni")
  validoDal       DateTime      @map("valido_dal") @db.Date
  validoAl        DateTime?     @map("valido_al") @db.Date
  preferito       Boolean       @default(false)

  @@unique([supplierId, materialId, validoDal])
  @@index([materialId])
  @@map("supplier_materials")
}

model SupplierAccessory {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  supplierId      String         @map("supplier_id") @db.Uuid
  supplier        Supplier       @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  accessoryId     String         @map("accessory_id") @db.Uuid
  accessory       Accessory      @relation(fields: [accessoryId], references: [id], onDelete: Cascade)
  codiceFornitore String?        @map("codice_fornitore")
  prezzoUnitario  Decimal        @map("prezzo_unitario") @db.Decimal(10, 2)
  unitaMisura     AccessoryUnita @map("unita_misura")
  quantitaMinima  Decimal?       @map("quantita_minima") @db.Decimal(10, 2)
  leadTimeGiorni  Int?           @map("lead_time_giorni")
  validoDal       DateTime       @map("valido_dal") @db.Date
  validoAl        DateTime?      @map("valido_al") @db.Date
  preferito       Boolean        @default(false)

  @@unique([supplierId, accessoryId, validoDal])
  @@index([accessoryId])
  @@map("supplier_accessories")
}

model SupplierServicePrice {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  supplierId        String    @map("supplier_id") @db.Uuid
  supplier          Supplier  @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  categoriaServizio String    @map("categoria_servizio")
  nomeServizio      String    @map("nome_servizio")
  prezzoMinimo      Decimal?  @map("prezzo_minimo") @db.Decimal(10, 2)
  prezzoMassimo     Decimal?  @map("prezzo_massimo") @db.Decimal(10, 2)
  unitaMisura       String?   @map("unita_misura")
  validoDal         DateTime  @map("valido_dal") @db.Date
  validoAl          DateTime? @map("valido_al") @db.Date
  note              String?

  @@index([supplierId])
  @@map("supplier_service_prices")
}

// =====================================================================
// TRACCIAMENTO IMPORT (Database_Schema.md §2, richiesta di Giulia
// 2026-08-05). Registra ogni import massivo (es. da Billy, da Shopify, da
// export fornitore) con esito riga per riga, per audit e per poter
// rilanciare/correggere un import fallito.
// =====================================================================

model ImportBatch {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String?      @map("user_id") @db.Uuid
  user             User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  nomeFile         String       @map("nome_file")
  fileHash         String       @unique @map("file_hash")
  tipoImportazione String       @map("tipo_importazione")
  stato            ImportStatus @default(in_corso)
  righeTotali      Int          @default(0) @map("righe_totali")
  righeImportate   Int          @default(0) @map("righe_importate")
  numeroErrori     Int          @default(0) @map("numero_errori")
  numeroWarning    Int          @default(0) @map("numero_warning")
  startedAt        DateTime     @default(now()) @map("started_at") @db.Timestamptz(6)
  completedAt      DateTime?    @map("completed_at") @db.Timestamptz(6)

  errors    ImportError[]
  snapshots InventorySnapshot[]

  @@index([userId])
  @@map("import_batches")
}

model ImportError {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  importBatchId   String      @map("import_batch_id") @db.Uuid
  importBatch     ImportBatch @relation(fields: [importBatchId], references: [id], onDelete: Cascade)
  severity        String
  numeroRiga      Int?        @map("numero_riga")
  tabellaTarget   String?     @map("tabella_target")
  campo           String?
  codiceRecord    String?     @map("codice_record")
  messaggio       String
  valoreOriginale Json?       @map("valore_originale")
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([importBatchId])
  @@map("import_errors")
}

// =====================================================================
// VISTA CLIENTE SHOWROOM (richiesta di Giulia 2026-08-06, DEC-044).
// Il catalogo mostrato al cliente non è una seconda anagrafica: è la
// stessa tabella `products` filtrata dai due attributi commerciali
// `visibile_showroom` (capo appeso allo stand) e
// `personalizzabile_su_misura`. Qui vive solo ciò che nasce dal lato
// cliente e non esiste nel gestionale: l'accesso con i consensi, cosa ha
// guardato, cosa ha messo tra i preferiti, cosa ha chiesto.
// =====================================================================

enum ShowroomRequestTipo {
  personalizzazione
  informazioni
}

// Stati elencati nella specifica §7. `confermato` è il punto in cui la
// richiesta genera l'ordine SM-* nel gestionale.
enum StatoRichiestaShowroom {
  nuova_richiesta
  da_contattare
  appuntamento_fissato
  misure_raccolte
  preventivo_inviato
  confermato
  in_produzione
  pronto
  consegnato
  annullato
}

/// Un accesso alla vista cliente: nome, cognome, email e i consensi raccolti
/// prima di entrare. Il contatto confluisce in `customers` (tipologia
/// `showroom`, dedup per email) — questa tabella tiene la traccia temporale
/// dell'accesso, che in `customers` andrebbe persa a ogni nuova visita.
model ShowroomVisit {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId          String   @map("customer_id") @db.Uuid
  customer            Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  nome                String
  cognome             String
  email               String
  consensoPrivacy     Boolean  @default(false) @map("consenso_privacy")
  consensoMarketing   Boolean  @default(false) @map("consenso_marketing")
  informativaVersione String   @map("informativa_versione")
  iniziataIl          DateTime @default(now()) @map("iniziata_il") @db.Timestamptz(6)
  ultimaAttivitaIl    DateTime @updatedAt @map("ultima_attivita_il") @db.Timestamptz(6)

  views     ShowroomProductView[]
  favorites ShowroomFavorite[]
  requests  ShowroomRequest[]

  @@index([customerId])
  @@index([iniziataIl])
  @@map("showroom_visits")
}

/// Prodotti aperti dal cliente durante una visita. Una riga per capo, con
/// contatore: interessa quante volte è stato guardato, non ogni singolo click.
model ShowroomProductView {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  visitId         String        @map("visit_id") @db.Uuid
  visit           ShowroomVisit @relation(fields: [visitId], references: [id], onDelete: Cascade)
  productId       String        @map("product_id") @db.Uuid
  product         Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  visualizzazioni Int           @default(1)
  ultimaVistaIl   DateTime      @default(now()) @map("ultima_vista_il") @db.Timestamptz(6)

  @@unique([visitId, productId])
  @@index([productId])
  @@map("showroom_product_views")
}

/// Preferiti del cliente: legati al contatto (restano fra una visita e l'altra),
/// con il riferimento alla visita in cui sono stati aggiunti.
model ShowroomFavorite {
  id         String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId String         @map("customer_id") @db.Uuid
  customer   Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId  String         @map("product_id") @db.Uuid
  product    Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  visitId    String?        @map("visit_id") @db.Uuid
  visit      ShowroomVisit? @relation(fields: [visitId], references: [id], onDelete: SetNull)
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([customerId, productId])
  @@index([productId])
  @@map("showroom_favorites")
}

/// La "scheda" creata nel gestionale da una richiesta del cliente (spec §7):
/// personalizzazione su misura o semplice richiesta di informazioni. I campi
/// prima di `noteInterne` arrivano dal cliente, quelli dopo li compila l'atelier.
model ShowroomRequest {
  id                  String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  numero              String                 @unique
  tipo                ShowroomRequestTipo    @default(personalizzazione)
  stato               StatoRichiestaShowroom @default(nuova_richiesta)
  customerId          String                 @map("customer_id") @db.Uuid
  customer            Customer               @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId           String?                @map("product_id") @db.Uuid
  product             Product?               @relation(fields: [productId], references: [id], onDelete: SetNull)
  visitId             String?                @map("visit_id") @db.Uuid
  visit               ShowroomVisit?         @relation(fields: [visitId], references: [id], onDelete: SetNull)
  tagliaBase          String?                @map("taglia_base")
  coloreDesiderato    String?                @map("colore_desiderato")
  lunghezza           String?
  modifiche           String?
  note                String?
  misure              Json?
  dataDesiderata      DateTime?              @map("data_desiderata") @db.Date
  noteInterne         String?                @map("note_interne")
  preventivoImporto   Decimal?               @map("preventivo_importo") @db.Decimal(12, 2)
  preventivoInviatoIl DateTime?              @map("preventivo_inviato_il") @db.Timestamptz(6)
  appuntamentoIl      DateTime?              @map("appuntamento_il") @db.Timestamptz(6)
  orderId             String?                @unique @map("order_id") @db.Uuid
  order               Order?                 @relation(fields: [orderId], references: [id], onDelete: SetNull)
  createdAt           DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)

  immagini ShowroomRequestImage[]

  @@index([customerId])
  @@index([productId])
  @@index([stato])
  @@map("showroom_requests")
}

/// Immagini di riferimento allegate dal cliente (facoltative, spec §7):
/// stesso schema delle foto scheda tecnica — data URL, limite lato API.
model ShowroomRequestImage {
  id         String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requestId  String          @map("request_id") @db.Uuid
  request    ShowroomRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  nome       String
  dataUrl    String          @map("data_url")
  caricataIl DateTime        @default(now()) @map("caricata_il") @db.Timestamptz(6)

  @@index([requestId])
  @@map("showroom_request_images")
}

// =====================================================================
// BOLLE / DDT DI LAVORAZIONE ESTERNA (richiesta di Giulia 2026-08-10)
//
// Il problema che risolvono. Quando l'azienda consegna tessuti, zip, bottoni ed
// etichette a un lavorante, quella roba **resta di proprietà dell'azienda**: non è
// una vendita e non è un consumo. Prima di queste tabelle il gestionale non sapeva
// dirlo — o il materiale era in casa, o risultava utilizzato. Un metro affidato a
// un terzista spariva dalla disponibilità solo quando qualcuno lo scaricava a mano,
// e nessuno sapeva più quanto fosse fuori né presso chi.
//
// Le tre giacenze che ne escono, per ogni materiale:
//   in casa         = acquistato − utilizzato − presso terzisti   (si può consegnare/tagliare)
//   presso terzisti = somma delle bolle emesse non ancora riconciliate
//   patrimonio      = acquistato − utilizzato                     (in casa + presso terzisti)
//
// L'ubicazione "presso il lavorante" riusa il tipo `produzione_esterna` già previsto in
// `InventoryLocationType`: non è stata creata una struttura parallela.
// =====================================================================

/// Testata della bolla di uscita verso un lavorante.
///
/// Sul numero: una bozza **non ha numero**. Il progressivo si assegna all'emissione,
/// dentro la transazione e sotto lock, perché un registro di documenti non può avere
/// buchi: se una bozza venisse abbandonata dopo aver bruciato un numero, quel numero
/// mancherebbe per sempre e la numerazione non sarebbe più difendibile. Finché è bozza
/// l'interfaccia mostra "Bozza · <id breve>".
model BollaLavorazione {
  id          String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Numero del documento in forma leggibile, es. "DDT-2026-0001". Null finché è bozza.
  numero      String?               @unique
  /// Le due componenti da cui `numero` è costruito: servono a ordinare e a calcolare il
  /// progressivo successivo senza dover interpretare la stringa.
  anno        Int?
  progressivo Int?
  data        DateTime              @db.Date
  causale     BollaCausale          @default(conto_lavorazione)
  stato       BollaLavorazioneStato @default(bozza)

  /// Il lavorante/terzista. È un fornitore dell'anagrafica esistente (categorie
  /// Confezione, Modellistica/Confezione, Ricami, Smacchinatore…): non serviva una
  /// seconda rubrica di soggetti con nome e partita IVA.
  supplierId          String   @map("supplier_id") @db.Uuid
  supplier            Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  /// Anagrafica del lavorante congelata al momento dell'emissione: una bolla di due anni
  /// fa deve restare leggibile anche se il fornitore nel frattempo ha cambiato ragione
  /// sociale o è stato riclassificato.
  lavoranteNome       String?  @map("lavorante_nome")
  lavorantePartitaIva String?  @map("lavorante_partita_iva")

  /// Cosa si sta facendo produrre: il capo e, quando c'è, la versione di scheda tecnica
  /// che il lavorante deve seguire.
  productId        String?         @map("product_id") @db.Uuid
  product          Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  technicalSheetId String?         @map("technical_sheet_id") @db.Uuid
  technicalSheet   TechnicalSheet? @relation(fields: [technicalSheetId], references: [id], onDelete: SetNull)
  /// Commessa/ordine di lavorazione. Testo libero: la commessa di un lavorante spesso è
  /// un riferimento del lavorante stesso e non un ordine di vendita del gestionale.
  /// Quando invece l'origine è un ordine interno, `orderId` lo collega davvero.
  commessa         String?
  orderId          String?         @map("order_id") @db.Uuid
  order            Order?          @relation(fields: [orderId], references: [id], onDelete: SetNull)
  /// Quanti capi finiti ci si aspetta indietro. Serve a confrontare l'atteso col rientrato.
  quantitaAttesa   Int             @default(0) @map("quantita_attesa")

  note                String?
  /// Nota obbligatoria quando la bolla viene chiusa pur non quadrando (vedi `chiusaConDifferenza`).
  differenzaNote      String? @map("differenza_note")
  /// true quando la chiusura è stata forzata da admin/CEO con quantità ancora fuori.
  /// Distingue una lavorazione che torna dai conti da una che è stata chiusa per decisione.
  chiusaConDifferenza Boolean @default(false) @map("chiusa_con_differenza")

  createdBy   String?   @map("created_by") @db.Uuid
  creataDa    User?     @relation("BollaCreata", fields: [createdBy], references: [id], onDelete: SetNull)
  emessaDa    String?   @map("emessa_da") @db.Uuid
  emittente   User?     @relation("BollaEmessa", fields: [emessaDa], references: [id], onDelete: SetNull)
  emessaIl    DateTime? @map("emessa_il") @db.Timestamptz(6)
  chiusaDa    String?   @map("chiusa_da") @db.Uuid
  chiuditore  User?     @relation("BollaChiusa", fields: [chiusaDa], references: [id], onDelete: SetNull)
  chiusaIl    DateTime? @map("chiusa_il") @db.Timestamptz(6)
  annullataIl DateTime? @map("annullata_il") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  righe     BollaRiga[]
  rientri   BollaRientro[]
  movimenti MovimentoLavorazione[]
  allegati  BollaAllegato[]

  @@index([supplierId])
  @@index([stato])
  @@index([data])
  @@map("bolle_lavorazione")
}

/// Riga di materiale consegnato. I campi `descrizione`, `sku` e `unitaMisura` sono copie
/// **storiche** prese al momento in cui la riga è stata creata: se domani l'anagrafica del
/// tessuto cambia nome o codice, la bolla dell'anno scorso continua a dire cosa è uscito
/// davvero. Gli id restano collegati per poter risalire all'articolo di oggi.
model BollaRiga {
  id      String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bollaId String           @map("bolla_id") @db.Uuid
  bolla   BollaLavorazione @relation(fields: [bollaId], references: [id], onDelete: Cascade)

  /// Esattamente uno dei tre è valorizzato: tessuto, accessorio (zip, bottoni, etichette,
  /// passamaneria…) o variante di capo, che è il caso del semilavorato.
  materialId  String?         @map("material_id") @db.Uuid
  material    Material?       @relation(fields: [materialId], references: [id], onDelete: SetNull)
  accessoryId String?         @map("accessory_id") @db.Uuid
  accessory   Accessory?      @relation(fields: [accessoryId], references: [id], onDelete: SetNull)
  variantId   String?         @map("variant_id") @db.Uuid
  variant     ProductVariant? @relation("BollaRigaVariante", fields: [variantId], references: [id], onDelete: SetNull)

  descrizione String
  sku         String?
  unitaMisura String  @map("unita_misura")
  lotto       String?
  colore      String?
  variante    String?
  note        String?
  ordine      Int     @default(0)

  /// La provenienza è congelata sulla riga: se la bolla usa scampoli, un eventuale
  /// rientro inutilizzato deve tornare nella stessa riserva e non gonfiare il magazzino.
  provenienza   BollaRigaProvenienza @default(magazzino)
  /// Valore unitario fotografato quando nasce la riga. Le modifiche successive
  /// all'anagrafica non riscrivono il costo storico della lavorazione.
  costoUnitario Decimal              @default(0) @map("costo_unitario") @db.Decimal(12, 4)
  fonteCosto    CostSource           @default(materiale) @map("fonte_costo")

  quantitaInviata          Decimal @default(0) @map("quantita_inviata") @db.Decimal(12, 4)
  /// Totali cumulati sui rientri registrati, mantenuti qui per non doverli ricalcolare a
  /// ogni lettura e per poter mettere il vincolo "non si può restituire più di quanto
  /// consegnato" su un dato solo.
  ///   ancora presso il lavorante = inviata − utilizzata − restituita − recuperata − persa
  quantitaUtilizzata       Decimal @default(0) @map("quantita_utilizzata") @db.Decimal(12, 4)
  quantitaRestituita       Decimal @default(0) @map("quantita_restituita") @db.Decimal(12, 4)
  quantitaScartoRecuperato Decimal @default(0) @map("quantita_scarto_recuperato") @db.Decimal(12, 4)
  /// La colonna fisica mantiene il nome originale per conservare senza riscritture gli
  /// scarti già registrati prima della distinzione: quelli storici erano perdite reali.
  quantitaScartoPerso      Decimal @default(0) @map("quantita_scartata") @db.Decimal(12, 4)

  righeRientro BollaRientroRiga[]
  movimenti    MovimentoLavorazione[]

  @@index([bollaId])
  @@map("bolle_lavorazione_righe")
}

/// Un rientro dal lavorante: il documento che lui consegna insieme alla merce.
/// Più rientri possono riferirsi alla stessa bolla — è il caso normale quando la
/// produzione arriva scaglionata.
model BollaRientro {
  id                       String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bollaId                  String           @map("bolla_id") @db.Uuid
  bolla                    BollaLavorazione @relation(fields: [bollaId], references: [id], onDelete: Cascade)
  data                     DateTime         @db.Date
  /// Numero del DDT emesso dal lavorante, così come sta scritto sul suo documento.
  numeroDocumentoLavorante String?          @map("numero_documento_lavorante")
  note                     String?
  createdBy                String?          @map("created_by") @db.Uuid
  registratoDa             User?            @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  createdAt                DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  righe     BollaRientroRiga[]
  capi      BollaRientroCapo[]
  movimenti MovimentoLavorazione[]
  allegati  BollaAllegato[]

  @@index([bollaId])
  @@map("bolle_lavorazione_rientri")
}

/// Cosa è successo a una riga di materiale **in questo rientro**. Lo scarto recuperabile
/// resta patrimonio e va nella riserva scampoli; lo scarto perso esce dal patrimonio ed è
/// valorizzato separatamente dal consumo utile.
model BollaRientroRiga {
  id                       String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  rientroId                String       @map("rientro_id") @db.Uuid
  rientro                  BollaRientro @relation(fields: [rientroId], references: [id], onDelete: Cascade)
  rigaId                   String       @map("riga_id") @db.Uuid
  riga                     BollaRiga    @relation(fields: [rigaId], references: [id], onDelete: Cascade)
  quantitaUtilizzata       Decimal      @default(0) @map("quantita_utilizzata") @db.Decimal(12, 4)
  quantitaRestituita       Decimal      @default(0) @map("quantita_restituita") @db.Decimal(12, 4)
  quantitaScartoRecuperato Decimal      @default(0) @map("quantita_scarto_recuperato") @db.Decimal(12, 4)
  quantitaScartoPerso      Decimal      @default(0) @map("quantita_scartata") @db.Decimal(12, 4)
  note                     String?

  @@unique([rientroId, rigaId])
  @@index([rigaId])
  @@map("bolle_lavorazione_rientri_righe")
}

/// Capi finiti arrivati con un rientro. Entrano nell'inventario prodotti finiti
/// (`inventory_records.qta_magazzino`) con un movimento tracciato.
model BollaRientroCapo {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  rientroId String         @map("rientro_id") @db.Uuid
  rientro   BollaRientro   @relation(fields: [rientroId], references: [id], onDelete: Cascade)
  variantId String         @map("variant_id") @db.Uuid
  variant   ProductVariant @relation("BollaRientroCapoVariante", fields: [variantId], references: [id], onDelete: Restrict)
  /// Copie storiche, stessa ragione delle righe materiale.
  sku       String
  taglia    String
  colore    String
  quantita  Int
  note      String?

  @@index([rientroId])
  @@index([variantId])
  @@map("bolle_lavorazione_rientri_capi")
}

/// Registro dei movimenti generati dalle bolle. Ogni riga è agganciata alla **riga di
/// bolla** che l'ha prodotta (e al rientro, quando ne nasce da uno): è la richiesta di
/// tracciabilità — dal movimento si risale sempre al documento, alla persona e al perché.
///
/// Questa tabella non sostituisce `inventory_movements`, che resta il registro delle
/// varianti fra magazzino e laboratorio: i capi finiti caricati da un rientro scrivono in
/// **entrambe**, così chi guarda la scheda della variante vede il carico dove se lo aspetta.
model MovimentoLavorazione {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bollaId   String           @map("bolla_id") @db.Uuid
  bolla     BollaLavorazione @relation(fields: [bollaId], references: [id], onDelete: Cascade)
  rigaId    String?          @map("riga_id") @db.Uuid
  riga      BollaRiga?       @relation(fields: [rigaId], references: [id], onDelete: SetNull)
  rientroId String?          @map("rientro_id") @db.Uuid
  rientro   BollaRientro?    @relation(fields: [rientroId], references: [id], onDelete: SetNull)

  tipo          MovimentoLavorazioneTipo
  da            LavorazioneUbicazione
  a             LavorazioneUbicazione
  quantita      Decimal                  @db.Decimal(12, 4)
  costoUnitario Decimal                  @default(0) @map("costo_unitario") @db.Decimal(12, 4)
  valore        Decimal                  @default(0) @db.Decimal(14, 2)

  materialId  String? @map("material_id") @db.Uuid
  accessoryId String? @map("accessory_id") @db.Uuid
  variantId   String? @map("variant_id") @db.Uuid
  /// Descrizione storica dell'articolo movimentato: il registro deve restare leggibile
  /// anche se l'articolo viene cancellato dall'anagrafica.
  descrizione String
  unitaMisura String  @map("unita_misura")

  motivo     String?
  note       String?
  createdBy  String?  @map("created_by") @db.Uuid
  eseguitoDa User?    @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([bollaId])
  @@index([rigaId])
  @@index([createdAt])
  @@map("movimenti_lavorazione")
}

/// Allegati della bolla: il PDF del documento emesso da noi e, sul rientro, la scansione
/// del DDT ricevuto dal lavorante. Stesso schema delle foto scheda tecnica — data URL nel
/// database, così finisce nei backup insieme al resto.
model BollaAllegato {
  id         String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bollaId    String           @map("bolla_id") @db.Uuid
  bolla      BollaLavorazione @relation(fields: [bollaId], references: [id], onDelete: Cascade)
  /// Valorizzato quando l'allegato appartiene a un rientro invece che alla testata.
  rientroId  String?          @map("rientro_id") @db.Uuid
  rientro    BollaRientro?    @relation(fields: [rientroId], references: [id], onDelete: Cascade)
  nome       String
  dataUrl    String           @map("data_url")
  createdBy  String?          @map("created_by") @db.Uuid
  caricatoDa User?            @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  caricatoIl DateTime         @default(now()) @map("caricato_il") @db.Timestamptz(6)

  @@index([bollaId])
  @@index([rientroId])
  @@map("bolle_lavorazione_allegati")
}
