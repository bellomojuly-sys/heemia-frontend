}

// --- Bolle / DDT di lavorazione esterna (richiesta di Giulia 2026-08-10) ---
//
// Ciclo del documento. Una bolla nasce `bozza` e in quello stato **non tocca nessuna
// giacenza**: è un foglio che si sta ancora compilando. All'emissione i materiali escono
// dal magazzino e si fermano "presso il lavorante"; da lì tornano indietro (restituiti),
// spariscono (consumati o scartati) oppure restano fuori finché non arriva un altro rientro.
//
//   bozza → emessa → parzialmente_rientrata → chiusa
//     ↓        ↓
//   annullata (solo finché nessun rientro è stato registrato)
enum BollaLavorazioneStato {
  bozza
  emessa
  parzialmente_rientrata
  chiusa
  annullata
}

/// Perché la merce esce. "Conto lavorazione" è il caso normale (il lavorante trasforma
/// materiale nostro e ce lo restituisce come capo); gli altri servono a non forzare
/// dentro quella causale uscite che hanno tutt'altro significato fiscale e operativo.
enum BollaCausale {
  conto_lavorazione
  conto_visione
  riparazione
  campionatura
  reso_a_fornitore
  altro
}

/// Cosa è successo alla quantità. Il `tipo` dice il fatto, le due ubicazioni dicono da
/// dove a dove: insieme rendono il registro sommabile per differenza.
///
/// Sullo scarto ci sono **due** tipi e non uno, perché in atelier lo scarto non è una cosa
/// sola: i ritagli di una pezza spesso si riusano (tasche, campioni, capi piccoli) e restano
/// patrimonio, mentre il tessuto rovinato è perso davvero. Trattarli insieme voleva dire
/// scaricare come perdita della roba che è ancora in casa.
enum MovimentoLavorazioneTipo {
  uscita_materiale
  rientro_inutilizzato
  consumo
  scarto_recuperato
  scarto
  carico_finiti
  storno_uscita
}

/// Estremi di un movimento del registro lavorazioni. `magazzino`, `produzione_esterna` e
/// `scampoli` sono posti reali dove la merce sta; `consumato` e `scarto` non lo sono — sono
/// i due modi in cui una quantità **esce dal patrimonio**. Tenerli qui come estremi di
/// destinazione è ciò che permette al registro di quadrare: ogni riga ha sempre un "da" e un
/// "a", e la somma per ubicazione ricostruisce le giacenze.
enum LavorazioneUbicazione {
  magazzino
  produzione_esterna
  scampoli
  consumato
  scarto
}

/// Da quale riserva viene prelevata una riga. Gli scampoli sono patrimonio disponibile
/// per usi compatibili, ma non devono essere confusi con una pezza o un articolo integro.
enum BollaRigaProvenienza {
  magazzino
  scampoli
}

// --- Import tracking (Database_Schema.md §2) ---
enum ImportStatus {
  in_corso
  completato
  completato_con_errori
  fallito
}

// ---------- MODELLI ----------
model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome         String
  email        String   @unique
  role         Role
  passwordHash String?  @map("password_hash")
  attivo       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  activityLogs         ActivityLog[]
  aiSessions           AiSession[]
  sessions             Session[]
  approvedRequests     SupplierRequest[]      @relation("ApprovedBy")
  inventoryMovements   InventoryMovement[]
  importBatches        ImportBatch[]
  measurementTemplates MeasurementTemplate[]
  patternDocuments     PatternDocument[]
  patternDocumentNotes PatternDocumentNote[]
  campioniApprovati    Product[]              @relation("CampioneApprovato")
  stockCommitments     StockCommitment[]
  bolleCreate          BollaLavorazione[]     @relation("BollaCreata")
  bolleEmesse          BollaLavorazione[]     @relation("BollaEmessa")
  bolleChiuse          BollaLavorazione[]     @relation("BollaChiusa")
  rientriRegistrati    BollaRientro[]
  movimentiLavorazione MovimentoLavorazione[]
  allegatiBolla        BollaAllegato[]

  @@map("users")
}

// Sessioni server-side revocabili (System_Architecture §4).
model Session {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role
  scope     String   @default("interno") // "interno" | "showroom"
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId])
  @@map("sessions")
}

model AppSetting {
  chiave    String   @id
  valore    String
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("app_settings")
}

model ActivityLog {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String?  @map("user_id") @db.Uuid
  user             User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  azione           String
  entita           String
  entitaId         String?  @map("entita_id")
  valorePrecedente String?  @map("valore_precedente")
  valoreNuovo      String?  @map("valore_nuovo")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdAt])
  @@map("activity_logs")
}

model AiSession {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String?     @map("user_id") @db.Uuid
  user      User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  messages  AiMessage[]

  @@map("ai_sessions")
}

model AiMessage {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId String    @map("session_id") @db.Uuid
  session   AiSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  autore    AiAutore
  testo     String
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("ai_messages")
}

model Supplier {
  id                  String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome                String
  /// Partita IVA: è la chiave con cui si riconosce il fornitore nelle fatture elettroniche,
  /// dove il nome può essere scritto in modi diversi (FR-19, import FatturaPA).
  partitaIva          String?           @map("partita_iva")
  categoria           SupplierCategoria
  citta               String?
  paese               String            @default("IT")
  email               String?
  referente           String?
  telefono            String?
  tempiMediConsegnaGg Int?              @map("tempi_medi_consegna_gg")
  condizioniPagamento String?           @map("condizioni_pagamento")
  note                String?
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  materials         Material[]
  accessories       Accessory[]
  requests          SupplierRequest[]
  invoices          Invoice[]
  schedeLaboratorio TechnicalSheet[]       @relation("LaboratorioConfezione")
  righeSchede       SheetMaterialUsage[]
  listiniMateriali  SupplierMaterial[]
  listiniAccessori  SupplierAccessory[]
  listiniServizi    SupplierServicePrice[]
  /// Bolle di lavorazione esterna in cui questo fornitore è il lavorante (2026-08-10).
  bolleLavorazione  BollaLavorazione[]

  @@map("suppliers")
}

model Product {
  id                        String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome                      String
  codiceProdotto            String               @unique @map("codice_prodotto")
  categoria                 String?
  collezione                String?
  stagione                  String?
  linea                     Linea
  stato                     ProductStage         @default(idea)
  descrizioneBreve          String?              @map("descrizione_breve")
  descrizioneBreveStato     BozzaStato           @default(bozza) @map("descrizione_breve_stato")
  descrizioneEcommerce      String?              @map("descrizione_ecommerce")
  descrizioneTecnica        String?              @map("descrizione_tecnica")
  consigliCura              String?              @map("consigli_cura")
  consigliCuraStato         BozzaStato           @default(bozza) @map("consigli_cura_stato")
  vestibilita               String?
  taglieDisponibili         String[]             @default([]) @map("taglie_disponibili")
  coloriDisponibili         String[]             @default([]) @map("colori_disponibili")
  immaginiUrl               String[]             @default([]) @map("immagini_url")
  prezzoVendita             Decimal              @default(0) @map("prezzo_vendita") @db.Decimal(12, 2)
  prezzoNettoIva            Decimal              @default(0) @map("prezzo_netto_iva") @db.Decimal(12, 2)
  prezzoShowroom            Decimal              @default(0) @map("prezzo_showroom") @db.Decimal(12, 2)
  prezzoConsigliato         Decimal              @default(0) @map("prezzo_consigliato") @db.Decimal(12, 2)
  statoPubblicazioneShopify PubblicazioneShopify @default(non_pubblicato) @map("stato_pubblicazione_shopify")
  disponibilitaOnline       Boolean              @default(false) @map("disponibilita_online")
  disponibilitaShowroom     Boolean              @default(false) @map("disponibilita_showroom")
  // Attributi commerciali che decidono la vista cliente (spec 2026-08-06, DEC-044):
  // `visibileShowroom` = capo fisicamente appeso allo stand (stato commerciale, non si
  // deduce dalle giacenze); `personalizzabileSuMisura` = realizzabile o adattabile su
  // misura anche se non è in showroom. Il catalogo cliente è la loro unione.
  visibileShowroom          Boolean              @default(false) @map("visibile_showroom")
  personalizzabileSuMisura  Boolean              @default(false) @map("personalizzabile_su_misura")
  /// Tempi indicativi di realizzazione mostrati al cliente sul su misura (spec §6).
  tempiRealizzazione        String?              @map("tempi_realizzazione")
  // Approvazione del campione (backlog "Note" §6): la produzione parte solo dopo che il
  // campione è stato ricevuto, controllato e approvato. Finché è null il passaggio alla
  // fase "produzione" resta bloccato.
  campioneApprovatoIl       DateTime?            @map("campione_approvato_il") @db.Timestamptz(6)
  campioneApprovatoDa       String?              @map("campione_approvato_da") @db.Uuid
  campioneApprovatore       User?                @relation("CampioneApprovato", fields: [campioneApprovatoDa], references: [id], onDelete: SetNull)
  campioneNote              String?              @map("campione_note")
  createdAt                 DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  variants          ProductVariant[]
  technicalSheets   TechnicalSheet[]
  productionSteps   ProductionStep[]
  materials         ProductMaterial[]
  accessories       ProductAccessory[]
  orderItems        OrderItem[]
  invoiceLinks      InvoiceProduct[]
  supplierReqs      SupplierRequest[]
  patternDocuments  PatternDocument[]
  stockCommitments  StockCommitment[]
  showroomViews     ShowroomProductView[]
  showroomFavorites ShowroomFavorite[]
  showroomRequests  ShowroomRequest[]
  bolleLavorazione  BollaLavorazione[]

  // Colonne filtrate in listProducts()/listProduction() (products/service.ts, production/service.ts).
  @@index([stato])
  @@index([linea])
  @@map("products")
}

model ProductIdea {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome             String
  concept          String?
  materialiStimati String?   @map("materiali_stimati")
  quantitaStimate  Int       @default(0) @map("quantita_stimate")
  noteCreative     String?   @map("note_creative")
  stato            IdeaStato @default(nuova)
  scanBozzettoUrl  String?   @map("scan_bozzetto_url")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("product_ideas")
}

model ProductVariant {
  id                 String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId          String       @map("product_id") @db.Uuid
  product            Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku                String       @unique
  taglia             String
  colore             String
  stockDisponibile   Int          @default(0) @map("stock_disponibile")
  stockRiservato     Int          @default(0) @map("stock_riservato")
  immagineUrl        String?      @map("immagine_url")
  statoDisponibilita VariantStato @default(disponibile) @map("stato_disponibilita")
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  inventory     InventoryRecord?
  orderItems    OrderItem[]
  balances      InventoryBalance[]
  movements     InventoryMovement[]
  snapshotItems InventorySnapshotItem[]
  impegni       StockCommitment[]
  righeBolle    BollaRiga[]             @relation("BollaRigaVariante")
  capiRientrati BollaRientroCapo[]      @relation("BollaRientroCapoVariante")

  @@index([productId])
  @@map("product_variants")
}

model Material {
  id                  String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome                String
  codice              String        @unique
  supplierId          String?       @map("supplier_id") @db.Uuid
  supplier            Supplier?     @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  composizione        String?
  colore              String?
  altezzaCm           Decimal?      @map("altezza_cm") @db.Decimal(6, 1)
  prezzoAlMetro       Decimal       @default(0) @map("prezzo_al_metro") @db.Decimal(10, 2)
  metriAcquistati     Decimal       @default(0) @map("metri_acquistati") @db.Decimal(10, 2)
  metriUtilizzati     Decimal       @default(0) @map("metri_utilizzati") @db.Decimal(10, 2)
  /// Metri fisicamente **presso un lavorante** per una bolla emessa (2026-08-10).
  /// Non sono usciti dal patrimonio: sono ancora nostri, semplicemente non sono in casa.
  metriPressoTerzisti Decimal       @default(0) @map("metri_presso_terzisti") @db.Decimal(10, 2)
  /// Ritagli riutilizzabili tornati da una lavorazione (2026-08-10, decisione di Giulia:
  /// "gli scarti spesso li riutilizziamo"). Sono in casa e sono nostri, ma non sono pezza
  /// intera: con 3 m di scampoli non si taglia un cappotto. Per questo stanno in un
  /// contatore a sé e **non** entrano nel disponibile per il taglio.
  ///
  /// Le tre letture che ne derivano:
  ///   patrimonio            = acquistati − utilizzati                              (tutto ciò che è nostro)
  ///   disponibile al taglio = acquistati − utilizzati − presso terzisti − scampoli  (pezza intera in casa)
  ///   scampoli              = questo campo                                         (usabile, ma spezzato)
  metriScampoli       Decimal       @default(0) @map("metri_scampoli") @db.Decimal(10, 2)
  dataAcquisto        DateTime?     @map("data_acquisto") @db.Date
  stagione            String?
  consigliLavaggio    String?       @map("consigli_lavaggio")
  noteTecniche        String?       @map("note_tecniche")
  sogliaMinima        Decimal       @default(0) @map("soglia_minima") @db.Decimal(10, 2)
  stato               MaterialStato @default(disponibile)
  unitaMisura         MaterialUnita @default(m) @map("unita_misura")
  fatturaId           String?       @map("fattura_id") @db.Uuid
  fattura             Invoice?      @relation(fields: [fatturaId], references: [id], onDelete: SetNull)
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  products         ProductMaterial[]
  tsPrincipale     TechnicalSheet[]         @relation("TessutoPrincipale")
  tsSecondari      TechnicalSheetMaterial[]
  invoiceLinks     InvoiceMaterial[]
  supplierReqs     SupplierRequest[]
  orderItems       OrderItem[]
  righeSchede      SheetMaterialUsage[]
  listiniFornitori SupplierMaterial[]
  righeBolle       BollaRiga[]

  @@index([supplierId])
  // Filtro stato in listMaterials()/listStockAlerts() (materials/service.ts).
  @@index([stato])
  @@map("materials")
}

model Accessory {
  id                     String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome                   String
  codice                 String         @unique
  categoria              String?
  supplierId             String?        @map("supplier_id") @db.Uuid
  supplier               Supplier?      @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  quantitaAcquistata     Decimal        @default(0) @map("quantita_acquistata") @db.Decimal(10, 2)
  quantitaUtilizzata     Decimal        @default(0) @map("quantita_utilizzata") @db.Decimal(10, 2)
  /// Quantità presso un lavorante per una bolla emessa: stessa logica dei tessuti,
  /// vedi `Material.metriPressoTerzisti`.
  quantitaPressoTerzisti Decimal        @default(0) @map("quantita_presso_terzisti") @db.Decimal(10, 2)
  /// Accessori recuperati da una lavorazione (zip smontate, bottoni ripresi da un capo
  /// scartato): riutilizzabili ma non nuovi. Vedi `Material.metriScampoli`.
  quantitaScampoli       Decimal        @default(0) @map("quantita_scampoli") @db.Decimal(10, 2)
  costoUnitario          Decimal        @default(0) @map("costo_unitario") @db.Decimal(10, 2)
  sogliaMinima           Decimal        @default(0) @map("soglia_minima") @db.Decimal(10, 2)
  stato                  MaterialStato  @default(disponibile)
  unitaMisura            AccessoryUnita @default(cad) @map("unita_misura")
  fatturaId              String?        @map("fattura_id") @db.Uuid
  fattura                Invoice?       @relation(fields: [fatturaId], references: [id], onDelete: SetNull)
  createdAt              DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  products         ProductAccessory[]
  tsAccessori      TechnicalSheetAccessory[]
  supplierReqs     SupplierRequest[]
  righeSchede      SheetMaterialUsage[]
  listiniFornitori SupplierAccessory[]
  righeBolle       BollaRiga[]

  @@index([supplierId])
  // Filtro stato in listAccessories()/listStockAlerts() (materials/service.ts).
  @@index([stato])
  @@map("accessories")
}

model ProductMaterial {
