  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@id([productId, materialId])
  @@map("product_materials")
}

model ProductAccessory {
  productId   String    @map("product_id") @db.Uuid
  accessoryId String    @map("accessory_id") @db.Uuid
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  accessory   Accessory @relation(fields: [accessoryId], references: [id], onDelete: Cascade)

  @@id([productId, accessoryId])
  @@map("product_accessories")
}

model TechnicalSheet {
  id                   String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId            String     @map("product_id") @db.Uuid
  product              Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  versione             TsVersion
  tessutoPrincipaleId  String?    @map("tessuto_principale_id") @db.Uuid
  tessutoPrincipale    Material?  @relation("TessutoPrincipale", fields: [tessutoPrincipaleId], references: [id], onDelete: SetNull)
  composizioneCompleta String?    @map("composizione_completa")
  pesoCapoGrammi       Decimal?   @map("peso_capo_grammi") @db.Decimal(8, 1)
  lavorazione          String?
  trattamenti          String?
  lavaggioConsigliato  String?    @map("lavaggio_consigliato")
  noteProduzione       String?    @map("note_produzione")
  difficoltaProduttiva Difficolta @default(media) @map("difficolta_produttiva")
  tempiStimatiOre      Decimal    @default(0) @map("tempi_stimati_ore") @db.Decimal(8, 2)
  costoManodopera      Decimal    @default(0) @map("costo_manodopera") @db.Decimal(10, 2)
  costoTessuto         Decimal    @default(0) @map("costo_tessuto") @db.Decimal(10, 2)
  costoAccessori       Decimal    @default(0) @map("costo_accessori") @db.Decimal(10, 2)
  costoPackaging       Decimal    @default(0) @map("costo_packaging") @db.Decimal(10, 2)
  altriCostiDiretti    Decimal    @default(0) @map("altri_costi_diretti") @db.Decimal(10, 2)
  altriCostiIndiretti  Decimal    @default(0) @map("altri_costi_indiretti") @db.Decimal(10, 2)
  archiviata           Boolean    @default(false)
  pdfUrl               String?    @map("pdf_url")
  pdfCaricatoIl        DateTime?  @map("pdf_caricato_il") @db.Timestamptz(6)
  createdAt            DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  // --- Scheda tecnica strutturata (estensione 2026-07-30, chiude OQ-18) ---
  // Prima questi campi vivevano solo nel browser (localStorage): non erano condivisi
  // tra utenti né inclusi nei backup. Ora sono nel database.
  statoScheda                StatoScheda   @default(bozza) @map("stato_scheda")
  // Anagrafica denormalizzata: precompilata dal prodotto ma editabile per versione.
  nomeProdotto               String?       @map("nome_prodotto")
  codiceProdotto             String?       @map("codice_prodotto")
  collezione                 String?
  categoria                  String?
  descrizioneTecnica         String?       @map("descrizione_tecnica")
  taglieDisponibili          String[]      @default([]) @map("taglie_disponibili")
  misureVestibilita          String?       @map("misure_vestibilita")
  istruzioniConfezione       String?       @map("istruzioni_confezione")
  noteTecniche               String?       @map("note_tecniche")
  fornitoreLaboratorioId     String?       @map("fornitore_laboratorio_id") @db.Uuid
  fornitoreLaboratorio       Supplier?     @relation("LaboratorioConfezione", fields: [fornitoreLaboratorioId], references: [id], onDelete: SetNull)
  // Divisore per l'ammortamento dei costi di sviluppo sui capi previsti.
  quantitaPrevistaProduzione Int           @default(50) @map("quantita_prevista_produzione")
  noteVersione               String?       @map("note_versione")
  // PDF caricato dal dispositivo (data URL base64). Vedi nota dimensioni in Database_Schema.
  pdfFileNome                String?       @map("pdf_file_nome")
  pdfFileDataUrl             String?       @map("pdf_file_data_url")
  pdfFileCaricatoIl          DateTime?     @map("pdf_file_caricato_il") @db.Timestamptz(6)
  // Esito dell'ultima scansione AI del PDF (FR-14).
  scanAiAnalizzatoIl         DateTime?     @map("scan_ai_analizzato_il") @db.Timestamptz(6)
  scanAiNomeFile             String?       @map("scan_ai_nome_file")
  scanAiNote                 String?       @map("scan_ai_note")
  scanAiAffidabilita         Affidabilita? @map("scan_ai_affidabilita")
  scanAiVociEstratte         Int?          @map("scan_ai_voci_estratte")

  materiali      TechnicalSheetMaterial[]
  accessori      TechnicalSheetAccessory[]
  righeMateriali SheetMaterialUsage[]
  righeCosti     SheetCostLine[]
  foto           TechnicalSheetPhoto[]
  storicoCosti   SheetCostSnapshot[]
  misure         SheetMeasurement[]
  bolle          BollaLavorazione[]

  @@unique([productId, versione])
  @@index([productId])
  @@map("technical_sheets")
}

// Misura tecnica del capo (backlog "Note" §3). L'elenco cambia con la categoria: viene
// proposto dall'AI o compilato a mano, e resta modificabile, riordinabile ed eliminabile.
// I valori numerici li inserisce il modellista, l'AI indica solo QUALI misure servono.
model SheetMeasurement {
  id                String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  technicalSheetId  String         @map("technical_sheet_id") @db.Uuid
  technicalSheet    TechnicalSheet @relation(fields: [technicalSheetId], references: [id], onDelete: Cascade)
  nome              String
  valore            Decimal?       @db.Decimal(8, 2)
  unita             String         @default("cm")
  tagliaRiferimento String?        @map("taglia_riferimento")
  tolleranza        String?
  nota              String?
  fonte             CostSource     @default(manuale)
  ordine            Int            @default(0)

  @@index([technicalSheetId])
  @@map("sheet_measurements")
}

// Modello di misure riutilizzabile per categoria: si salva un set una volta e lo si
// riapplica ai capi successivi della stessa tipologia.
model MeasurementTemplate {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome      String
  categoria String
  misure    Json
  createdBy String?  @map("created_by") @db.Uuid
  creatoDa  User?    @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([nome, categoria])
  @@map("measurement_templates")
}

// Documenti ricevuti dalle modelliste (backlog "Note" §4): cartamodelli, piazzamenti,
// schede misure, revisioni. Collegati al PRODOTTO e non alla singola scheda tecnica,
// perché uno stesso piazzamento può valere per più versioni. La versione è testo libero
// e NON è unica: caricare una V2 non sovrascrive mai la V1.
model PatternDocument {
  id                String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId         String               @map("product_id") @db.Uuid
  product           Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  fileName          String               @map("file_name")
  dataUrl           String               @map("data_url")
  tipologia         PatternDocumentTipo
  versione          String               @default("V1")
  autore            String?
  statoApprovazione PatternDocumentStato @default(in_attesa) @map("stato_approvazione")
  createdBy         String?              @map("created_by") @db.Uuid
  caricatoDa        User?                @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  note PatternDocumentNote[]

  @@index([productId])
  @@map("pattern_documents")
}

// Note del team su un documento della modellista: solo aggiunte, mai sovrascritte,
// così la discussione su correzioni e approvazioni resta leggibile per intero.
model PatternDocumentNote {
  id         String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  documentId String                  @map("document_id") @db.Uuid
  document   PatternDocument         @relation(fields: [documentId], references: [id], onDelete: Cascade)
  testo      String
  tipo       PatternDocumentNoteTipo @default(commento)
  createdBy  String?                 @map("created_by") @db.Uuid
  autore     User?                   @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  createdAt  DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([documentId])
  @@map("pattern_document_notes")
}

// Riga "materiale utilizzato" della scheda (spec §2/§3): tiene separata la quantità
// suggerita dal motore di stima da quella confermata a mano, conservando entrambe.
model SheetMaterialUsage {
  id                        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  technicalSheetId          String         @map("technical_sheet_id") @db.Uuid
  technicalSheet            TechnicalSheet @relation(fields: [technicalSheetId], references: [id], onDelete: Cascade)
  materialId                String?        @map("material_id") @db.Uuid
  material                  Material?      @relation(fields: [materialId], references: [id], onDelete: SetNull)
  accessoryId               String?        @map("accessory_id") @db.Uuid
  accessory                 Accessory?     @relation(fields: [accessoryId], references: [id], onDelete: SetNull)
  descrizione               String
  unitaMisura               String         @map("unita_misura")
  quantitaSuggerita         Decimal        @default(0) @map("quantita_suggerita") @db.Decimal(12, 4)
  quantitaConfermata        Decimal?       @map("quantita_confermata") @db.Decimal(12, 4)
  percentualeScarto         Decimal        @default(0) @map("percentuale_scarto") @db.Decimal(6, 2)
  supplierId                String?        @map("supplier_id") @db.Uuid
  supplier                  Supplier?      @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  // Fatture da cui è stato ricavato il costo: array di id, come le altre relazioni deboli.
  fattureCollegateIds       String[]       @default([]) @map("fatture_collegate_ids") @db.Uuid
  costoUnitario             Decimal        @default(0) @map("costo_unitario") @db.Decimal(12, 4)
  fonteCosto                CostSource     @default(manuale) @map("fonte_costo")
  fatturaCostoId            String?        @map("fattura_costo_id") @db.Uuid
  costoUnitarioAggiornatoIl DateTime       @default(now()) @map("costo_unitario_aggiornato_il") @db.Timestamptz(6)
  ordine                    Int            @default(0)

  @@index([technicalSheetId])
  @@map("sheet_material_usages")
}

// Voce di costo aggiuntiva oltre ai materiali (spec §4).
model SheetCostLine {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  technicalSheetId String         @map("technical_sheet_id") @db.Uuid
  technicalSheet   TechnicalSheet @relation(fields: [technicalSheetId], references: [id], onDelete: Cascade)
  voce             SheetCostVoce
  label            String
  importo          Decimal        @default(0) @db.Decimal(12, 2)
  kind             CostKind       @default(diretto)
  fonte            CostSource     @default(manuale)
  fatturaId        String?        @map("fattura_id") @db.Uuid
  // true per i costi di sviluppo da ripartire sui capi previsti.
  ammortizzabile   Boolean        @default(false)
  quantitaPrevista Int?           @map("quantita_prevista")
  ordine           Int            @default(0)

  @@index([technicalSheetId])
  @@map("sheet_cost_lines")
}

// Foto del prototipo (spec §1). `dataUrl` è l'immagine in base64: sta nel database
// perché deve finire nei backup (richiesta di Giulia, 2026-07-30).
model TechnicalSheetPhoto {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  technicalSheetId String         @map("technical_sheet_id") @db.Uuid
  technicalSheet   TechnicalSheet @relation(fields: [technicalSheetId], references: [id], onDelete: Cascade)
  nome             String
  dataUrl          String         @map("data_url")
  caricataIl       DateTime       @default(now()) @map("caricata_il") @db.Timestamptz(6)

  @@index([technicalSheetId])
