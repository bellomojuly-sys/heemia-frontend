}

// Snapshot storico del calcolo costi (spec §6): si aggiunge in coda, mai sovrascritto.
model SheetCostSnapshot {
  id                     String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  technicalSheetId       String         @map("technical_sheet_id") @db.Uuid
  technicalSheet         TechnicalSheet @relation(fields: [technicalSheetId], references: [id], onDelete: Cascade)
  registratoIl           DateTime       @default(now()) @map("registrato_il") @db.Timestamptz(6)
  motivo                 String
  costoMaterialiUnitario Decimal        @default(0) @map("costo_materiali_unitario") @db.Decimal(12, 2)
  costoTotaleUnitario    Decimal        @default(0) @map("costo_totale_unitario") @db.Decimal(12, 2)
  prezzoBreakEven        Decimal        @default(0) @map("prezzo_break_even") @db.Decimal(12, 2)

  @@index([technicalSheetId])
  @@map("sheet_cost_snapshots")
}

model TechnicalSheetMaterial {
  technicalSheetId String         @map("technical_sheet_id") @db.Uuid
  materialId       String         @map("material_id") @db.Uuid
  technicalSheet   TechnicalSheet @relation(fields: [technicalSheetId], references: [id], onDelete: Cascade)
