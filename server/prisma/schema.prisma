  @@map("technical_sheet_photos")
}

// Snapshot storico del calcolo costi (spec §6): si aggiunge in coda, mai sovrascritto.
model SheetCostSnapshot {
  id                     String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  technicalSheetId       String         @map("technical_sheet_id") @db.Uuid
  technicalSheet         TechnicalSheet @relation(fields: [technicalSheetId], references: [id], onDelete: Cascade)
  registratoIl           DateTime       @default(now()) @map("registrato_il") @db.Timestamptz(6)
  motivo                 String
  costoMaterialiUnitario Decimal        @default(0) @map("costo_materiali_unitario") @db.Decimal(12, 2)
  costoTotaleUnitario    Decimal        @default(0) @map("costo_totale_unitario") @db.Decimal(12, 2)
  prezzoBreakEven        Decimal        @default(0) @map("prezzo_break_even") @db.Decimal(12, 2)

  @@index([technicalSheetId])
  @@map("sheet_cost_snapshots")
}

model TechnicalSheetMaterial {
  technicalSheetId String         @map("technical_sheet_id") @db.Uuid
  materialId       String         @map("material_id") @db.Uuid
  technicalSheet   TechnicalSheet @relation(fields: [technicalSheetId], references: [id], onDelete: Cascade)
  material         Material       @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@id([technicalSheetId, materialId])
  @@map("technical_sheet_materials")
}

model TechnicalSheetAccessory {
  technicalSheetId String         @map("technical_sheet_id") @db.Uuid
  accessoryId      String         @map("accessory_id") @db.Uuid
  technicalSheet   TechnicalSheet @relation(fields: [technicalSheetId], references: [id], onDelete: Cascade)
  accessory        Accessory      @relation(fields: [accessoryId], references: [id], onDelete: Cascade)

  @@id([technicalSheetId, accessoryId])
  @@map("technical_sheet_accessories")
}

model ProductionStep {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId    String       @map("product_id") @db.Uuid
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  fase         ProductStage
  responsabile String?
  dataInizio   DateTime?    @map("data_inizio") @db.Date
  dataFine     DateTime?    @map("data_fine") @db.Date
  note         String?
  bloccata     Boolean      @default(false)
  motivoBlocco String?      @map("motivo_blocco")
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([productId])
  @@map("production_steps")
}

model Customer {
  id                     String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome                   String
  email                  String?
  paese                  String           @default("IT")
  tipologia              TipologiaCliente @default(ecommerce)
  valoreTotaleAcquistato Decimal          @default(0) @map("valore_totale_acquistato") @db.Decimal(12, 2)
  numeroOrdini           Int              @default(0) @map("numero_ordini")
  sconto                 Decimal?         @db.Decimal(5, 2)
  note                   String?
  createdAt              DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
