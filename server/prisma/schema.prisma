// Heemia App — schema Prisma (Fase 12)
// Derivato 1:1 dal DDL PostgreSQL approvato in Database_Schema.md (Fase 10, v1.0).
// La tabella `sessions` è aggiunta come da System_Architecture §4 ("sessioni server-side revocabili").
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- ENUM ----------
enum Role {
  admin
  ceo
  team
  viewer
  showroom
}

enum ProductStage {
  idea
  concept
  sviluppo_modello
  scelta_tessuto
  scelta_accessori
  prototipo
  campionario
  produzione
  foto_contenuti
  scheda_ecommerce
  pubblicato_shopify
  in_vendita
  archivio
}

enum Linea {
  tessile
  maglieria
}

enum BozzaStato {
  bozza
  approvata
}

enum PubblicazioneShopify {
  non_pubblicato
  bozza
  pubblicato
}

enum VariantStato {
  disponibile
  esaurito
  low_stock
}

enum IdeaStato {
  nuova
  in_valutazione
  promossa
}

enum TsVersion {
  preliminare
  piazzamento
  finale
}

// --- Enum della scheda tecnica strutturata (estensione 2026-07-30, chiude OQ-18) ---
enum StatoScheda {
  bozza
  in_revisione
  approvata
  archiviata
}

enum Affidabilita {
  alta
  media
  bassa
}

// Le 12 categorie di costo della scheda (spec §4).
enum SheetCostVoce {
  accessori
  lavorazioni
  taglio
  confezione
  ricamo_stampa
  sviluppo_modello
  disegno
  scheda_tecnica
  prototipazione
  logistica
  altro
}

// Un costo o è diretto del capo, o è di sviluppo da ammortizzare sui capi previsti.
enum CostKind {
  diretto
  sviluppo_ammortizzato
}

// Da dove arriva il costo: serve a distinguere un dato certo da una stima.
enum CostSource {
  fattura
  materiale
  fornitore
  manuale
  stimato
  ai
}

enum Difficolta {
  bassa
  media
  alta
}

enum MaterialStato {
  disponibile
  sotto_soglia
  esaurito
  da_verificare
}

enum MaterialUnita {
  m
  kg
}

enum AccessoryUnita {
  cad
  m
}

enum SupplierCategoria {
  Tessuti
  Filati
  Passamaneria
  Lycra
  Felpa
  Asole_Bottoni      @map("Asole/Bottoni")
  Fodere
  Cartellini_Etichette @map("Cartellini/Etichette")
  Accessori
  Zip
  Bottoni
  Accessori_vari     @map("Accessori vari")
  Biglietti
  Spalline
  Modellistica_Confezione @map("Modellistica/Confezione")
  Modellistica
  Ricami
  Smacchinatore
  Confezione
  Commercialista
  Marchi_e_brevetti  @map("Marchi e brevetti")
  Consulenza
}

enum SupplierReqStato {
  bozza_generata
  in_attesa_approvazione
  modificata
  approvata
  inviata
  risposta_ricevuta
  chiusa
  annullata
}

enum Urgenza {
  bassa
  media
  alta
}

enum CategoriaCosto {
  tessuto
  accessori
  manodopera
  packaging
  spedizione
  marketing
  logistica
  servizi
  costi_generali
}

enum InvoicePaese {
  IT
  EU
  Extra_EU           @map("Extra-EU")
}

enum InvoicePagamento {
  da_pagare
  pagata
  scaduta
}

enum ModalitaAllocazione {
  diretto_prodotto
  per_categoria
  per_collezione
  per_numero_capi
  per_fatturato
  per_mese
  non_allocabile
}

enum TipoScadenza {
  fattura_da_pagare
  fattura_da_incassare
  iva
  contributi
  fornitore
  commercialista
  reminder
  abbonamento
}

enum DeadlineStato {
  in_arrivo
  in_ritardo
  saldata
}

enum TipologiaCliente {
  ecommerce
  showroom
  b2b
  retailer
  showroom_partner
}

enum OrderCanale {
  shopify
  fisico
}

enum OrderStato {
  in_lavorazione
  spedito
  consegnato
  annullato
}

enum OrderPriorita {
  normale
  alta
}

enum InventoryStato {
  disponibile
  esaurito
  low_stock
}

enum AiAutore {
  utente
  assistant
}

// --- Magazzino multi-ubicazione (Database_Schema.md §2, richiesta di Giulia 2026-08-05) ---
enum InventoryLocationType {
  magazzino
  laboratorio
  showroom
  resi
  produzione_esterna
}

enum InventoryMovementType {
  carico
  scarico
  trasferimento
  rettifica
}

// --- Import tracking (Database_Schema.md §2) ---
enum ImportStatus {
  in_corso
  completato
  completato_con_errori
  fallito
}

// ---------- MODELLI ----------
model User {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome          String
  email         String   @unique
  role          Role
  passwordHash  String?  @map("password_hash")
  attivo        Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  activityLogs       ActivityLog[]
  aiSessions         AiSession[]
  sessions           Session[]
  approvedRequests   SupplierRequest[]   @relation("ApprovedBy")
  inventoryMovements InventoryMovement[]
  importBatches      ImportBatch[]

  @@map("users")
}

// Sessioni server-side revocabili (System_Architecture §4).
model Session {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role
  scope     String   @default("interno") // "interno" | "showroom"
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId])
  @@map("sessions")
}

model AppSetting {
  chiave    String   @id
  valore    String
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("app_settings")
}

model ActivityLog {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String?  @map("user_id") @db.Uuid
  user             User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  azione           String
  entita           String
  entitaId         String?  @map("entita_id")
  valorePrecedente String?  @map("valore_precedente")
  valoreNuovo      String?  @map("valore_nuovo")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdAt])
  @@map("activity_logs")
}

model AiSession {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String?     @map("user_id") @db.Uuid
  user      User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  messages  AiMessage[]

  @@map("ai_sessions")
}

model AiMessage {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId String    @map("session_id") @db.Uuid
  session   AiSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  autore    AiAutore
  testo     String
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("ai_messages")
}

model Supplier {
  id                   String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome                 String
  categoria            SupplierCategoria
  citta                String?
  paese                String            @default("IT")
  email                String?
  referente            String?
  telefono             String?
  tempiMediConsegnaGg  Int?              @map("tempi_medi_consegna_gg")
  condizioniPagamento  String?           @map("condizioni_pagamento")
  note                 String?
  createdAt            DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  materials   Material[]
  accessories Accessory[]
  requests    SupplierRequest[]
  invoices    Invoice[]
  schedeLaboratorio TechnicalSheet[]     @relation("LaboratorioConfezione")
  righeSchede       SheetMaterialUsage[]
  listiniMateriali  SupplierMaterial[]
  listiniAccessori  SupplierAccessory[]
  listiniServizi    SupplierServicePrice[]

  @@map("suppliers")
}

model Product {
  id                        String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome                      String
  codiceProdotto            String               @unique @map("codice_prodotto")
  categoria                 String?
  collezione                String?
  stagione                  String?
  linea                     Linea
  stato                     ProductStage         @default(idea)
  descrizioneBreve          String?              @map("descrizione_breve")
  descrizioneBreveStato     BozzaStato           @default(bozza) @map("descrizione_breve_stato")
  descrizioneEcommerce      String?              @map("descrizione_ecommerce")
  descrizioneTecnica        String?              @map("descrizione_tecnica")
  consigliCura              String?              @map("consigli_cura")
  consigliCuraStato         BozzaStato           @default(bozza) @map("consigli_cura_stato")
  vestibilita               String?
  taglieDisponibili         String[]             @default([]) @map("taglie_disponibili")
  coloriDisponibili         String[]             @default([]) @map("colori_disponibili")
  immaginiUrl               String[]             @default([]) @map("immagini_url")
  prezzoVendita             Decimal              @default(0) @map("prezzo_vendita") @db.Decimal(12, 2)
  prezzoNettoIva            Decimal              @default(0) @map("prezzo_netto_iva") @db.Decimal(12, 2)
  prezzoShowroom            Decimal              @default(0) @map("prezzo_showroom") @db.Decimal(12, 2)
  prezzoConsigliato         Decimal              @default(0) @map("prezzo_consigliato") @db.Decimal(12, 2)
  statoPubblicazioneShopify PubblicazioneShopify @default(non_pubblicato) @map("stato_pubblicazione_shopify")
  disponibilitaOnline       Boolean              @default(false) @map("disponibilita_online")
  disponibilitaShowroom     Boolean              @default(false) @map("disponibilita_showroom")
  visibileShowroom          Boolean              @default(false) @map("visibile_showroom")
  personalizzabileSuMisura  Boolean              @default(false) @map("personalizzabile_su_misura")
  createdAt                 DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  variants        ProductVariant[]
  technicalSheets TechnicalSheet[]
  productionSteps ProductionStep[]
  materials       ProductMaterial[]
  accessories     ProductAccessory[]
  orderItems      OrderItem[]
  invoiceLinks    InvoiceProduct[]
  supplierReqs    SupplierRequest[]

  // Colonne filtrate in listProducts()/listProduction() (products/service.ts, production/service.ts).
  @@index([stato])
  @@index([linea])
  @@map("products")
}

model ProductIdea {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome             String
  concept          String?
  materialiStimati String?   @map("materiali_stimati")
  quantitaStimate  Int       @default(0) @map("quantita_stimate")
  noteCreative     String?   @map("note_creative")
  stato            IdeaStato @default(nuova)
  scanBozzettoUrl  String?   @map("scan_bozzetto_url")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("product_ideas")
}

model ProductVariant {
  id                 String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId          String       @map("product_id") @db.Uuid
  product            Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku                String       @unique
  taglia             String
  colore             String
  stockDisponibile   Int          @default(0) @map("stock_disponibile")
  stockRiservato     Int          @default(0) @map("stock_riservato")
  immagineUrl        String?      @map("immagine_url")
  statoDisponibilita VariantStato @default(disponibile) @map("stato_disponibilita")
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  inventory  InventoryRecord?
  orderItems OrderItem[]
  balances      InventoryBalance[]
  movements     InventoryMovement[]
  snapshotItems InventorySnapshotItem[]

  @@index([productId])
  @@map("product_variants")
}

model Material {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome             String
  codice           String        @unique
  supplierId       String?       @map("supplier_id") @db.Uuid
  supplier         Supplier?     @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  composizione     String?
  colore           String?
  altezzaCm        Decimal?      @map("altezza_cm") @db.Decimal(6, 1)
  prezzoAlMetro    Decimal       @default(0) @map("prezzo_al_metro") @db.Decimal(10, 2)
  metriAcquistati  Decimal       @default(0) @map("metri_acquistati") @db.Decimal(10, 2)
  metriUtilizzati  Decimal       @default(0) @map("metri_utilizzati") @db.Decimal(10, 2)
  dataAcquisto     DateTime?     @map("data_acquisto") @db.Date
  stagione         String?
  consigliLavaggio String?       @map("consigli_lavaggio")
  noteTecniche     String?       @map("note_tecniche")
  sogliaMinima     Decimal       @default(0) @map("soglia_minima") @db.Decimal(10, 2)
  stato            MaterialStato @default(disponibile)
  unitaMisura      MaterialUnita @default(m) @map("unita_misura")
  fatturaId        String?       @map("fattura_id") @db.Uuid
  fattura          Invoice?      @relation(fields: [fatturaId], references: [id], onDelete: SetNull)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  products        ProductMaterial[]
  tsPrincipale    TechnicalSheet[]         @relation("TessutoPrincipale")
  tsSecondari     TechnicalSheetMaterial[]
  invoiceLinks    InvoiceMaterial[]
  supplierReqs    SupplierRequest[]
  orderItems      OrderItem[]
  righeSchede     SheetMaterialUsage[]
  listiniFornitori SupplierMaterial[]

  @@index([supplierId])
  // Filtro stato in listMaterials()/listStockAlerts() (materials/service.ts).
  @@index([stato])
  @@map("materials")
}

model Accessory {
  id                 String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome               String
  codice             String         @unique
  categoria          String?
  supplierId         String?        @map("supplier_id") @db.Uuid
  supplier           Supplier?      @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  quantitaAcquistata Decimal        @default(0) @map("quantita_acquistata") @db.Decimal(10, 2)
  quantitaUtilizzata Decimal        @default(0) @map("quantita_utilizzata") @db.Decimal(10, 2)
  costoUnitario      Decimal        @default(0) @map("costo_unitario") @db.Decimal(10, 2)
  sogliaMinima       Decimal        @default(0) @map("soglia_minima") @db.Decimal(10, 2)
  stato              MaterialStato  @default(disponibile)
  unitaMisura        AccessoryUnita @default(cad) @map("unita_misura")
  fatturaId          String?        @map("fattura_id") @db.Uuid
  fattura            Invoice?       @relation(fields: [fatturaId], references: [id], onDelete: SetNull)
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  products     ProductAccessory[]
  tsAccessori  TechnicalSheetAccessory[]
  supplierReqs SupplierRequest[]
  righeSchede  SheetMaterialUsage[]
  listiniFornitori SupplierAccessory[]

  @@index([supplierId])
  // Filtro stato in listAccessories()/listStockAlerts() (materials/service.ts).
  @@index([stato])
  @@map("accessories")
}

model ProductMaterial {
  productId  String   @map("product_id") @db.Uuid
  materialId String   @map("material_id") @db.Uuid
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@id([productId, materialId])
  @@map("product_materials")
}

model ProductAccessory {
  productId   String    @map("product_id") @db.Uuid
  accessoryId String    @map("accessory_id") @db.Uuid
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  accessory   Accessory @relation(fields: [accessoryId], references: [id], onDelete: Cascade)

  @@id([productId, accessoryId])
  @@map("product_accessories")
}

model TechnicalSheet {
  id                   String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId            String     @map("product_id") @db.Uuid
  product              Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  versione             TsVersion
  tessutoPrincipaleId  String?    @map("tessuto_principale_id") @db.Uuid
  tessutoPrincipale    Material?  @relation("TessutoPrincipale", fields: [tessutoPrincipaleId], references: [id], onDelete: SetNull)
  composizioneCompleta String?    @map("composizione_completa")
  pesoCapoGrammi       Decimal?   @map("peso_capo_grammi") @db.Decimal(8, 1)
  lavorazione          String?
  trattamenti          String?
  lavaggioConsigliato  String?    @map("lavaggio_consigliato")
  noteProduzione       String?    @map("note_produzione")
  difficoltaProduttiva Difficolta @default(media) @map("difficolta_produttiva")
  tempiStimatiOre      Decimal    @default(0) @map("tempi_stimati_ore") @db.Decimal(8, 2)
  costoManodopera      Decimal    @default(0) @map("costo_manodopera") @db.Decimal(10, 2)
  costoTessuto         Decimal    @default(0) @map("costo_tessuto") @db.Decimal(10, 2)
  costoAccessori       Decimal    @default(0) @map("costo_accessori") @db.Decimal(10, 2)
  costoPackaging       Decimal    @default(0) @map("costo_packaging") @db.Decimal(10, 2)
  altriCostiDiretti    Decimal    @default(0) @map("altri_costi_diretti") @db.Decimal(10, 2)
  altriCostiIndiretti  Decimal    @default(0) @map("altri_costi_indiretti") @db.Decimal(10, 2)
  archiviata           Boolean    @default(false)
  pdfUrl               String?    @map("pdf_url")
  pdfCaricatoIl        DateTime?  @map("pdf_caricato_il") @db.Timestamptz(6)
  createdAt            DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  // --- Scheda tecnica strutturata (estensione 2026-07-30, chiude OQ-18) ---
  // Prima questi campi vivevano solo nel browser (localStorage): non erano condivisi
  // tra utenti né inclusi nei backup. Ora sono nel database.
  statoScheda               StatoScheda @default(bozza) @map("stato_scheda")
  // Anagrafica denormalizzata: precompilata dal prodotto ma editabile per versione.
  nomeProdotto              String?   @map("nome_prodotto")
  codiceProdotto            String?   @map("codice_prodotto")
  collezione                String?
  categoria                 String?
  descrizioneTecnica        String?   @map("descrizione_tecnica")
  taglieDisponibili         String[]  @default([]) @map("taglie_disponibili")
  misureVestibilita         String?   @map("misure_vestibilita")
  istruzioniConfezione      String?   @map("istruzioni_confezione")
  noteTecniche              String?   @map("note_tecniche")
  fornitoreLaboratorioId    String?   @map("fornitore_laboratorio_id") @db.Uuid
  fornitoreLaboratorio      Supplier? @relation("LaboratorioConfezione", fields: [fornitoreLaboratorioId], references: [id], onDelete: SetNull)
  // Divisore per l'ammortamento dei costi di sviluppo sui capi previsti.
  quantitaPrevistaProduzione Int      @default(50) @map("quantita_prevista_produzione")
  noteVersione              String?   @map("note_versione")
  // PDF caricato dal dispositivo (data URL base64). Vedi nota dimensioni in Database_Schema.
  pdfFileNome               String?   @map("pdf_file_nome")
  pdfFileDataUrl            String?   @map("pdf_file_data_url")
  pdfFileCaricatoIl         DateTime? @map("pdf_file_caricato_il") @db.Timestamptz(6)
  // Esito dell'ultima scansione AI del PDF (FR-14).
  scanAiAnalizzatoIl        DateTime? @map("scan_ai_analizzato_il") @db.Timestamptz(6)
  scanAiNomeFile            String?   @map("scan_ai_nome_file")
  scanAiNote                String?   @map("scan_ai_note")
  scanAiAffidabilita        Affidabilita? @map("scan_ai_affidabilita")
  scanAiVociEstratte        Int?      @map("scan_ai_voci_estratte")

  materiali   TechnicalSheetMaterial[]
  accessori   TechnicalSheetAccessory[]
  righeMateriali SheetMaterialUsage[]
  righeCosti     SheetCostLine[]
  foto           TechnicalSheetPhoto[]
  storicoCosti   SheetCostSnapshot[]

  @@unique([productId, versione])
  @@index([productId])
  @@map("technical_sheets")
}

// Riga "materiale utilizzato" della scheda (spec §2/§3): tiene separata la quantità
// suggerita dal motore di stima da quella confermata a mano, conservando entrambe.
model SheetMaterialUsage {
  id                        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  technicalSheetId          String         @map("technical_sheet_id") @db.Uuid
  technicalSheet            TechnicalSheet @relation(fields: [technicalSheetId], references: [id], onDelete: Cascade)
  materialId                String?        @map("material_id") @db.Uuid
  material                  Material?      @relation(fields: [materialId], references: [id], onDelete: SetNull)
  accessoryId               String?        @map("accessory_id") @db.Uuid
  accessory                 Accessory?     @relation(fields: [accessoryId], references: [id], onDelete: SetNull)
  descrizione               String
  unitaMisura               String         @map("unita_misura")
  quantitaSuggerita         Decimal        @default(0) @map("quantita_suggerita") @db.Decimal(12, 4)
  quantitaConfermata        Decimal?       @map("quantita_confermata") @db.Decimal(12, 4)
  percentualeScarto         Decimal        @default(0) @map("percentuale_scarto") @db.Decimal(6, 2)
  supplierId                String?        @map("supplier_id") @db.Uuid
  supplier                  Supplier?      @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  // Fatture da cui è stato ricavato il costo: array di id, come le altre relazioni deboli.
  fattureCollegateIds       String[]       @default([]) @map("fatture_collegate_ids") @db.Uuid
  costoUnitario             Decimal        @default(0) @map("costo_unitario") @db.Decimal(12, 4)
  fonteCosto                CostSource     @default(manuale) @map("fonte_costo")
  fatturaCostoId            String?        @map("fattura_costo_id") @db.Uuid
  costoUnitarioAggiornatoIl DateTime       @default(now()) @map("costo_unitario_aggiornato_il") @db.Timestamptz(6)
  ordine                    Int            @default(0)

  @@index([technicalSheetId])
  @@map("sheet_material_usages")
}

// Voce di costo aggiuntiva oltre ai materiali (spec §4).
model SheetCostLine {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  technicalSheetId String         @map("technical_sheet_id") @db.Uuid
  technicalSheet   TechnicalSheet @relation(fields: [technicalSheetId], references: [id], onDelete: Cascade)
  voce             SheetCostVoce
  label            String
  importo          Decimal        @default(0) @db.Decimal(12, 2)
  kind             CostKind       @default(diretto)
  fonte            CostSource     @default(manuale)
  fatturaId        String?        @map("fattura_id") @db.Uuid
  // true per i costi di sviluppo da ripartire sui capi previsti.
  ammortizzabile   Boolean        @default(false)
  quantitaPrevista Int?           @map("quantita_prevista")
  ordine           Int            @default(0)

  @@index([technicalSheetId])
  @@map("sheet_cost_lines")
}

// Foto del prototipo (spec §1). `dataUrl` è l'immagine in base64: sta nel database
// perché deve finire nei backup (richiesta di Giulia, 2026-07-30).
model TechnicalSheetPhoto {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  technicalSheetId String         @map("technical_sheet_id") @db.Uuid
  technicalSheet   TechnicalSheet @relation(fields: [technicalSheetId], references: [id], onDelete: Cascade)
